# Example environment variables for Notes Backend
# Copy to .env and adjust as needed (do not commit secrets).

# Database URL (async driver for SQLite is aiosqlite)
# For SQLite (local file):
DATABASE_URL=sqlite+aiosqlite:///./notes.db
# For Postgres:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# JWT settings
JWT_SECRET_KEY=PLEASE_CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ALLOW_ORIGINS=*
